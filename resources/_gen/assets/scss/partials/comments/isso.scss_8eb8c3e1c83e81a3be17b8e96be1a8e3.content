.isso{color:var(--body-text-color)}.isso a{color:var(--accent-color)}.isso a:hover{color:var(--accent-color-darker)}.isso-thread-heading{color:var(--body-text-color)}.isso-comment{color:var(--body-text-color)}.isso-comment-header{color:var(--body-text-color)}.isso-comment-footer{color:var(--body-text-color)}.isso-author{color:var(--accent-color)}.isso-text{color:var(--body-text-color)}.isso-reply,.isso-follow-up{color:var(--body-text-color)}.isso-postbox,.isso-form-wrapper{color:var(--body-text-color)}.isso-input-wrapper{color:var(--body-text-color)}.isso-textarea{color:var(--body-text-color);background-color:var(--body-background);border-color:var(--accent-color-darker)}.isso-textarea::placeholder{color:var(--body-text-color);opacity:.6}.isso-textarea:focus{border-color:var(--accent-color);outline-color:var(--accent-color)}.isso-preview{color:var(--body-text-color);background-color:var(--body-background)}.isso-auth-section{color:var(--body-text-color)}.isso-notification-section,.isso-note{color:var(--body-text-color)}.isso-post-action{color:var(--body-text-color)}.isso-upvote,.isso-downvote,.isso-edit,.isso-delete,.isso-permalink{color:var(--accent-color)}.isso-upvote:hover,.isso-downvote:hover,.isso-edit:hover,.isso-delete:hover,.isso-permalink:hover{color:var(--accent-color-darker)}.isso-votes{color:var(--body-text-color)}.isso-feedlink{color:var(--accent-color)}.isso-avatar{background-color:var(--body-background)}.isso-comment-loader,.isso-spacer{color:var(--body-text-color)}.isso #isso-postbox-author,.isso #isso-postbox-website,.isso #isso-postbox-email{color:var(--body-text-color)!important;background-color:var(--body-background)!important;border-color:var(--accent-color-darker)!important}.isso #isso-postbox-author::placeholder,.isso #isso-postbox-website::placeholder,.isso #isso-postbox-email::placeholder{color:var(--body-text-color)!important;opacity:.6}.isso #isso-postbox-author:focus,.isso #isso-postbox-website:focus,.isso #isso-postbox-email:focus{color:var(--body-text-color)!important;background-color:var(--body-background)!important;border-color:var(--accent-color)!important}.isso input[type=submit],.isso input[type=button]{color:var(--accent-color-text)!important;background-color:var(--accent-color)!important;border-color:var(--accent-color)!important}.isso input[type=submit]:hover,.isso input[type=button]:hover{color:var(--accent-color-text)!important;background-color:var(--accent-color-darker)!important;border-color:var(--accent-color-darker)!important}